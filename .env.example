# MirrorHR Environment Configuration
# 
# Instructions:
# 1. Copy this file to .env
# 2. Replace placeholder values with actual secrets
# 3. Never commit your .env file to version control!

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_URL=https://api.openai.com/v1/engines/gpt-3.5-turbo-instruct/completions
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.2

# Azure Cloud Settings
AZURE_CLOUD_URL=https://your-azure-instance.azurewebsites.net/
AZURE_CLOUD_URL_TEST=https://your-test-url.azurewebsites.net/
AZURE_HEADER_KEY=your-header-key-name
AZURE_HEADER_VALUE=your-header-key-value

# Azure Notification Hub
# Replace with your own connection string from the Azure portal
NOTIFICATION_HUB_CONNECTION_STRING=Endpoint=sb://mirrorhr-notifications.servicebus.windows.net/;SharedAccessKeyName=DefaultListenSharedAccessSignature;SharedAccessKey=your_key_here
NOTIFICATION_HUB_NAME=mirrorhr-notificationhub

# Stripe Settings (if using payments)
STRIPE_BACKEND_URL=https://your-stripe-backend.azurewebsites.net/
STRIPE_SECRET_KEY=sk_live_your_live_secret_key
STRIPE_SECRET_KEY_DEV=sk_test_your_test_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key
STRIPE_PUBLISHABLE_KEY_DEV=pk_test_your_test_publishable_key

# Apple Pay
APPLE_PAY_MERCHANT_ID=merchant.com.your.app.identifier

# SciChart License
SCICHART_LICENSE_KEY=your_scichart_license_key_here

# Feature Flags
# Set to "true" to enable features, "false" to disable
ENABLE_VIDEO_DIARY_NLP=true
ENABLE_REMOTE_MONITORING=true
ENABLE_OFFLINE_MODE=false
ENABLE_TELEMETRY=true