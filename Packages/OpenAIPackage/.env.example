# OpenAI API Configuration
# Usage: 
# 1. Copy this file to .env (never commit your .env file to version control!)
# 2. Replace the API key with your actual OpenAI API key
# 3. Call OpenAIConnector.loadEnvironment() early in your app initialization

# OpenAI API Key (required for production)
OPENAI_API_KEY=your_openai_api_key_here

# API URL (optional, defaults to GPT-3.5-turbo-instruct)
OPENAI_API_URL=https://api.openai.com/v1/engines/gpt-3.5-turbo-instruct/completions

# Parameters (optional)
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.2 